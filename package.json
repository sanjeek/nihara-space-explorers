    "test:playroom": "node tests/playroom.browser.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
